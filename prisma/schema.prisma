generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  Guest
  Free_Member  @map("Free Member")
  Pro_Member   @map("Pro Member")
  Admin
}

model User {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  email             String   @unique
  avatar            String?
  role              String   @default("Pro Member") // "Admin" | "Pro Member" | "Free Member" | "Guest"
  password          String?
  joinedDate        String   @default("12 Mar 2025")
  validUntil        String   @default("12 Mar 2026")
  coursesCompleted  Int      @default(0)
  savedPrompts      Int      @default(0)
  totalDownloads    Int      @default(0)
  streakDays        Int      @default(1)
  status            String?  @default("Active")
  bookmarks         String[] @default([])
  completedEpisodes String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("users")
}

type Instructor {
  name   String
  avatar String
  role   String
}

type Episode {
  id             String
  title          String
  duration       String
  completed      Boolean  @default(false)
  videoUrl       String
  description    String
  keyTopics      String[]
  articleContent String?
}

type Resource {
  title       String
  type        String
  size        String
  downloadUrl String
}

model Course {
  id                 String       @id @default(auto()) @map("_id") @db.ObjectId
  slug               String       @unique
  title              String
  subtitle           String
  thumbnail          String
  bannerImage        String
  category           String
  level              String       // Pemula | Menengah | Lanjutan
  progressPercentage Int          @default(0)
  totalEpisodes      Int          @default(0)
  completedEpisodes  Int          @default(0)
  instructor         Instructor
  episodes           Episode[]
  resources          Resource[]
  description        String
  isPublished        Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@map("courses")
}

model PromptPack {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  thumbnail      String
  category       String   // Karakter AI | Video Prompt | Visual Style | UGC | dll
  subCategory    String?
  aiModel        String   // Omni Flash | Nano Banana | Midjourney v6 | Flux.1 Pro | Kling AI | dll
  usageCount     Int      @default(0)
  isNew          Boolean  @default(false)
  isPopular      Boolean  @default(false)
  isPremium      Boolean  @default(false)
  difficulty     String   @default("Mudah") // Mudah | Sedang | Ahli
  aspectRatio    String   @default("16:9")  // 16:9 | 9:16 | 1:1 | 4:5
  tags           String[]
  promptText     String
  negativePrompt String?
  cameraSettings String?
  lighting       String?
  motion         String?
  voice          String?
  environment    String?
  tips           String[] @default([])
  author         String   @default("FIKSI Team")
  isPublished    Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("prompt_packs")
}

model DownloadAsset {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  thumbnail      String
  format         String   // PSD | PNG | LUT | Templates | Mockups | Icons | Storyboards
  size           String
  category       String
  downloadsCount Int      @default(0)
  tags           String[]
  fileUrl        String
  isPremium      Boolean  @default(false)
  isPublished    Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("download_assets")
}

model ExternalTool {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String
  category    String   // Image Gen | Video AI | Audio & Voice | LLM & Writing | Productivity | Automation | 3D & VFX
  url         String
  thumbnail   String
  pricingType String   // Free | Freemium | Paid | Free Trial
  isPremium   Boolean  @default(false)
  isFeatured  Boolean  @default(false)
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("external_tools")
}

model QRISPaymentTransaction {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String
  userName   String
  userEmail  String
  planName   String
  amount     Int
  qrisRef    String
  proofImage String?
  status     String   @default("Pending") // Pending | Approved | Rejected
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("qris_transactions")
}

type BlogAuthor {
  name   String
  avatar String
}

type TocItem {
  id    String
  title String
}

model BlogArticle {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  slug            String       @unique
  title           String
  coverImage      String
  category        String
  readTime        String
  publishedAt     String
  author          BlogAuthor
  excerpt         String
  content         String
  tags            String[]
  tableOfContents TocItem[]
  isPublished     Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("blog_articles")
}

model WeeklyUpdate {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  version    String
  date       String
  title      String
  highlights String[]
  createdAt  DateTime @default(now())

  @@map("weekly_updates")
}
